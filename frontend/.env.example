# copy to .env.local and fill in

# backend URL (default: local dev backend)
VITE_API_BASE=http://localhost:8000

# Spotify playlist onboarding (optional — feature is hidden when unset).
# Create an app at https://developer.spotify.com/dashboard, add
#   http://127.0.0.1:5180/        (NOT localhost — Spotify rejects it;
#                                  the app hops to 127.0.0.1 automatically)
# and your deployed origin + "/" as Redirect URIs, then paste the Client ID
# here. No client secret needed (PKCE).
VITE_SPOTIFY_CLIENT_ID=
